#include<bits/stdc++.h>
using namespace std;
 
 
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int ax,ay,bx,by,cx,cy;
    cin>>ax>>ay>>bx>>by>>cx>>cy;
    long long x = (1LL*(bx-ax)*(cy-ay)) - (1LL*(by-ay)*(cx-ax));
    if(x > 0) cout<<"LEFT";
    else if(x==0) cout<<"TOWARDS";
    else cout<<"RIGHT";
 
    return 0;
} 